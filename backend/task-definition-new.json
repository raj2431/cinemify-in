{
  "containerDefinitions": [
    {
      "name": "Main",
      "image": "681293277785.dkr.ecr.ap-south-1.amazonaws.com/cinemify-in:latest",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 5000,
          "hostPort": 5000,
          "protocol": "tcp",
          "name": "main-5000-tcp",
          "appProtocol": "http"
        }
      ],
      "essential": true,
      "environment": [],
      "environmentFiles": [],
      "mountPoints": [],
      "volumesFrom": [],
      "ulimits": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/cinemify-api-task-1",
          "awslogs-create-group": "true",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs"
        },
        "secretOptions": []
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL\", \"wget -qO- http://localhost:5000/api/health || exit 1"
        ],
        "interval": 60,
        "timeout": 5,
        "retries": 3
      },
      "systemControls": []
    }
  ],
  "family": "cinemify-api-task-1",
  "executionRoleArn": "arn:aws:iam::681293277785:role/service-role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "volumes": [],
  "placementConstraints": [],
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "1024",
  "memory": "3072",
  "enableFaultInjection": false
}