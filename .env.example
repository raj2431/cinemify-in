# Used by docker-compose.yml only (local dev without Docker uses backend/.env and frontend/.env instead)

MYSQL_ROOT_PASSWORD=change_this_root_password
DB_NAME=cinemify
DB_USER=cinemify
DB_PASSWORD=change_this_app_password

JWT_SECRET=change_this_to_a_long_random_string
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

CORS_ORIGIN=http://localhost:8080

# Frontend is built with this baked in at build time (default /api works out of the box
# since nginx proxies /api to the backend container on the same origin)
VITE_API_URL=/api

# Optional: AWS S3 + CloudFront for admin uploads
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_CLOUDFRONT_DOMAIN=
